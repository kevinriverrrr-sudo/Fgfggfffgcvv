{
  "manifest_version": 3,
  "name": "RanobeLib Auto Reader",
  "version": "1.0.0",
  "description": "Автоматическое чтение глав на ranobelib.me",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.ranobelib.me/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.ranobelib.me/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
